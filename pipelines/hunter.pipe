		{
			"id": "db",
			"provider": "rocketride_sql",
			"config": {
				"profile": "default",
				"default": {
					"db_description": "Shared state of an outbound placement system that places IT consultants at US companies (PostgreSQL). consultants(id serial, box_file_id unique, full_name, title, skills text[] of lowercase canonical names, years_experience, hourly_rate_usd, location, availability, summary): our bench. opportunities(id serial, company, company_domain, role_title, job_url unique, required_skills text[], contact_name, contact_title, contact_email, contact_linkedin, hook, consultant_id -> consultants.id, match_rationale, stage text in new|contacted|replied|meeting_booked|lost|no_response, gmail_thread_id, do_not_contact boolean, created_at): one row per job signal. touches(id serial, opportunity_id -> opportunities.id, step int 1..3, direction text in out|in, subject, body, status text in scheduled|sent|received|cancelled, due_at timestamptz, sent_at timestamptz, gmail_message_id unique): the emails of a sequence; (opportunity_id, step) is unique for direction out. meetings(id serial, opportunity_id -> opportunities.id, calendar_event_id, starts_at). Rows with company 'Acme Test Co' are test records owned by another pipeline.",
					"table": "opportunities",
					"max_attempts": 3,
					"allow_execute": true
				},
				"parameters": {}
			},
			"control": [
				{
					"classType": "tool",
					"from": "hunter"
				}
			],
			"ui": {
				"position": {
					"x": 700,
