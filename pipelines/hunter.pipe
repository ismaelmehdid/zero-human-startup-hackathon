{
	"components": [
		{
			"id": "brief",
			"provider": "filestore_source",
			"config": {
				"hideForm": true,
				"mode": "Source",
				"parameters": {
					"path": "briefs/hunter.md",
					"recursive": false
				},
				"type": "filestore_source"
			},
			"ui": {
				"position": {
