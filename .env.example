# Copy to .env and fill in. Only ROCKETRIDE_* names are substituted into pipelines (any other name is redacted).

# Development connection (written by the RocketRide extension / `rocketride login`); used by scripts/ and the CLI.
ROCKETRIDE_URI=
ROCKETRIDE_APIKEY=

# LLM for every agent and rocketride_sql node in bench and hunter (llm_openai, profile openai-5-4).
ROCKETRIDE_OPENAI_KEY=
# No Anthropic key is needed: scripts/ reach the database through pipelines/db_admin.pipe, which only sends raw
# SQL and starts with a format-valid placeholder for ROCKETRIDE_ANTHROPIC_KEY.

# Demo mode: every outgoing email goes to this inbox with plus-addressing (name+company-slug@...).
ROCKETRIDE_DEMO_INBOX=

# bench: Box folder holding the consultant CVs.
ROCKETRIDE_BOX_TOKEN=
ROCKETRIDE_BOX_FOLDER_ID=

# hunter: job and company research. The Apify key is optional: without it, hunter drops its apify node.
ROCKETRIDE_GLASSER_KEY=
ROCKETRIDE_APIFY_KEY=
